."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SproutPaymentAddress"," addr"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["uint256 rkValue"]}]},{"tag":"li","children":[{"tag":"p","children":["vector<unsigned char> vchCryptedSecret"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":[{"tag":"strong","children":["defaultkey"]}]}]},{"tag":"td","children":[{"tag":"p","children":["Default Transparent key."]}]},{"tag":"td","children":[]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["CPubKey ","CWallet::vchDefaultKey"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["destdata*"]}]},{"tag":"td","children":[{"tag":"p","children":["Adds a destination data tuple to the store."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["std::string"," strAddress"]}]},{"tag":"li","children":[{"tag":"p","children":["std::string"," strKey"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["std::string"," strValue"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":[{"tag":"strong","children":["hdchain"]}]}]},{"tag":"td","children":[{"tag":"p","children":["Hierarchical Deterministic chain code, derived from seed."]}]},{"tag":"td","children":[]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["CHDChain chain"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["hdseed*"]}]},{"tag":"td","children":[{"tag":"p","children":["Hierarchical Deterministic seed. ",{"tag":"a","children":["[","4","]"],"id":"footnote-reference-3","href":"#zip-0032"}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["uint256 seedFp"]}]}]}]