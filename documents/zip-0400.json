}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["string strAddress"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":[{"tag":"strong","children":["orderposnext"]}]}]},{"tag":"td","children":[{"tag":"p","children":["Index of next tx."]}]},{"tag":"td","children":[]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["int64_t nOrderPosNext"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["pool*"]}]},{"tag":"td","children":[]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["int64_t nIndex"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["CKeyPool keypool"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["purpose*"]}]},{"tag":"td","children":[{"tag":"p","children":["Short description or identifier of an address."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["string strAddress"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["string strPurpose"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["sapzaddr*"]}]},{"tag":"td","children":[{"tag":"p","children":["Sapling z-addr Incoming Viewing key and address."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SaplingPaymentAddress"," addr"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SaplingIncomingViewingKey"," ivk"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["sapextfvk*"]}]},{"tag":"td","children":[{"tag":"p","children":["Sapling Extended Full Viewing Key"]}]},{"tag":"td","children":[]},{"tag":"td","children":[]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["sapzkey*"]}]},{"tag":"td","children":[{"tag":"p","children":["Sapling Incoming Viewing Key and Extended Spending Key"]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SaplingIncomingViewingKey"," ivk"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SaplingExtendedSpendingKey"," key"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["tx*"]}]},{"tag":"td","children":[{"tag":"p","children":["Store all transactions that are related to wallet."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["uint256 hash"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["CWalletTx wtx"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":[{"tag":"strong","children":["version"]}]}]},{"tag":"td","children":[{"tag":"p","children":["The ","CLIENT_VERSION"," from ","clientversion.h","."]}]},{"tag":"td","children":[]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["int nFileVersion"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["vkey*"]}]},{"tag":"td","children":[{"tag":"p","children":["Sprout Viewing Keys."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SproutViewingKey"," vk"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["char fYes"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["watchs*"]}]},{"tag":"td","children":[{"tag":"p","children":["Watch-only t-addresses."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["CScript script"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["char fYes"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":[{"tag":"strong","children":["witnesscachesize"]}]}]},{"tag":"td","children":[{"tag":"p","children":["Shielded Note Witness cache size."]}]},{"tag":"td","children":[]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["int64_t nWitnessCacheSize"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["wkey*"]}]},{"tag":"td","children":[{"tag":"p","children":["Wallet key."]}]},{"tag":"td","children":[]},{"tag":"td","children":[]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["zkey*"]}]},{"tag":"td","children":[{"tag":"p","children":["Sprout Payment Address and Spending Key."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SproutPaymentAddress"," addr"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SproutSpendingKey"," key"]}]}]}]}]},{"tag":"tr","children":[{"tag":"td","children":[{"tag":"p","children":["zkeymeta*"]}]},{"tag":"td","children":[{"tag":"p","children":["Sprout Payment Address and key metadata."]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["libzcash::SproutPaymentAddress"," addr"]}]}]}]},{"tag":"td","children":[{"tag":"ol","children":[{"tag":"li","children":[{"tag":"p","children":["CKeyMetadata keyMeta"]}]}]}]}]}]}]},{"tag":"h3","children":["Functionality"],"id":"functionality"},{"tag":"p","children":["When a zcashd node built with wallet support is started for the first time, a new wallet database is created. By default the node will automatically execute wallet actions that will be saved in the database at the first flush time."]},{"tag":"p","children":["The following flow will happen when a node with wallet support is started for the first time:"]},{"tag":"ul","children":[{"tag":"li","children":[{"tag":"p","children":["DEFAULT_KEYPOOL_SIZE"," (100 by default) keys will be added to the pool, creating 100 records with ","pool"," as property name (first value of database key)."]}]},{"tag":"li","children":[{"tag":"p","children":["Also 100 ","key"," properties will be added."]}]},{"tag":"li","children":[{"tag":"p","children":["100 ","keymeta","."]}]},{"tag":"li","children":[{"tag":"p","children":["Wallet will create a default transparent key to receive, this will be also added as ","key",", ","pool"," and ","keymeta"," properties."]}]},{"tag":"li","children":[{"tag":"p","children":["This default key is also added as a ","defaultkey"," property."]}]},{"tag":"li","children":[{"tag":"p","children":["The last action created an entry in the address book that is reflected in the database by the ","name"," and ","purpose"," properties."]}]},{"tag":"li","children":[{"tag":"p","children":["If the wallet is created with HD support, it will have additional properties ","hdseed"," and ","hdchain"," that will be saved."]}]},{"tag":"li","children":[{"tag":"p","children":["version",", ","minversion",", ","witnesscachesize"," and ","bestblock"," properties are added. These are settings and state information: the ","bestblock"," property is a good example of the database being populated that is happening without any user interaction, but it will just update as the best block of the current chain changes."]}]}]},{"tag":"p","children":["At any time after the database is created, new properties can be added as the wallet users perform actions. For example, if the user creates a new Sapling address with the RPC command ","z_getnewaddress"," then new records with properties ",{"tag":"em","children":["sapzkey"]}," and ",{"tag":"em","children":["sapzkeymeta"]}," will be added to the database."]},{"tag":"p","children":["In zcashd, database changes do not happen immediately but they are flushed in its own thread by ","ThreadFlushWalletDB()"," function periodically to avoid overhead. The internal counter ","nWalletDBUpdated"," is increased each time a new write operation to the database is done, this is compared with the last flush in order to commit new stuff."]},{"tag":"p","children":["When the node goes down for whatever reason the information in the wallet database SHOULD persist in the disk; the next time the node starts, the software will detect the database file, read from there and add the values into memory structures that will guarantee wallet functionality."]},{"tag":"h4","children":["Transactions"],"id":"transactions"},{"tag":"p","children":["The wallet database will not save all the transactions that are happening in the blockchain however it will save all transactions where wallet keys are involved. This is needed for example to get balances. Therefore the wallet must have all the transactions related to a key to compute the final value of coin available in the derived address."]},{"tag":"p","children":["The ","tx"," property will hold the transaction-related data with the transaction hash as the key and the full transaction as the value."]},{"tag":"h4","children":["Wallet state and transaction reordering"],"id":"wallet-state-and-transaction-reordering"},{"tag":"p","children":["Transactions are saved in the database ","tx"," key as they arrive, this means transactions have a sequence. The set of all transactions from the begging to a specified timestamp is the wallet state at that instant. Wallet state is important among other things to get current balance for a wallet or address."]},{"tag":"p","children":["In the blockchain, transactions can be invalidated by rollbacks; wallet code will handle this by updating the transactions in the memory database. New state needs to be reflected in the disk database, this is done in zcashd by the flag ","fAnyUnordered"," where if true at start time, will launch a rescan over all transactions again."]},{"tag":"h4","children":["Wallet Recovery"],"id":"wallet-recovery"},{"tag":"p","children":["The wallet database file may become corrupted. There are utilities in the ",{"tag":"em","children":["zcutil/bin"]}," directory that may help with recovering it if this happens. Please ask for help on the Zcash forum or Community Discord."]},{"tag":"h4","children":["Wallet Encryption"],"id":"wallet-encryption"},{"tag":"p","children":["Encryption will not be discussed in this document in detail as it is expected for the algorithm to change in the future according to the Wallet format ZIP issue: ",{"tag":"a","children":["[","3","]"],"id":"footnote-reference-4","href":"#zip400issue"},"."]},{"tag":"p","children":["For a deeper understanding of the current encryption mechanism please refer to ",{"tag":"a","children":["[","5","]"],"id":"footnote-reference-5","href":"#cryptercode"}]},{"tag":"h2","children":["References"],"id":"references"},{"tag":"p","children":["[1] ",{"tag":"a","children":["Information on BCP 14 — \"RFC 2119: Key words for use in RFCs to Indicate Requirement Levels\" and \"RFC 8174: Ambiguity of Uppercase vs Lowercase in RFC 2119 Key Words\""],"href":"https://www.rfc-editor.org/info/bcp14"}],"id":"bcp14"},{"tag":"p","children":["[2] ",{"tag":"a","children":["Oracle Berkeley Database"],"href":"https://www.oracle.com/database/berkeley-db/db.html"}],"id":"bdb"},{"tag":"p","children":["[3] ",{"tag":"a","children":["ZIP 400 issue"],"href":"https://github.com/zcash/zips/issues/350"}],"id":"zip400issue"},{"tag":"p","children":["[4] ",{"tag":"a","children":["ZIP 32: Shielded Hierarchical Deterministic Wallets"],"href":"?view=governance&section=zips&record=zip-0032"}],"id":"zip-0032"},{"tag":"p","children":["[5] ",{"tag":"a","children":["Database key encryption implementation"],"href":"https://github.com/zcash/zcash/blob/master/src/wallet/crypter.h"}],"id":"cryptercode"}]}
