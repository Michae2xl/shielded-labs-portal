{
  "name": "shielded-labs-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "SHIELDED_LABS_PREVIEW=1 next dev --hostname 127.0.0.1 --port 4248",
    "build": "next build",
    "build:feedback": "NEXT_PUBLIC_SHIELDED_LABS_FEEDBACK_PREVIEW=1 next build",
    "start": "SHIELDED_LABS_PREVIEW=1 next start --hostname 127.0.0.1 --port 4248",
    "start:feedback": "SHIELDED_LABS_PREVIEW=1 NEXT_PUBLIC_SHIELDED_LABS_FEEDBACK_PREVIEW=1 next start --hostname 127.0.0.1 --port 4248",
    "start:hosted": "SHIELDED_LABS_PREVIEW=1 NEXT_PUBLIC_SHIELDED_LABS_FEEDBACK_PREVIEW=1 next start --hostname 0.0.0.0 --port ${PORT:-8080}",
    "lint": "eslint src next.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:importer": "python3 scripts/shielded-preview/test-editorial-import.py",
    "test:zips": "python3 scripts/zips/test_import_zips.py",
    "import:zips": "python3 scripts/zips/import_zips.py --source ../zips",
    "import:article-text": "python3 scripts/shielded-preview/import-article-text.py",
    "check:isolation": "node scripts/check-isolation.mjs"
  },
  "dependencies": {
    "mermaid": "11.17.2",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
