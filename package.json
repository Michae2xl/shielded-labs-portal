{
  "name": "shielded-labs-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "SHIELDED_LABS_PREVIEW=1 next dev --hostname 127.0.0.1 --port 4248",
    "build": "next build",
    "start": "SHIELDED_LABS_PREVIEW=1 next start --hostname 127.0.0.1 --port 4248",
    "lint": "eslint src next.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:importer": "python3 scripts/shielded-preview/test-editorial-import.py",
    "check:isolation": "node scripts/check-isolation.mjs"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
