}," be as instantiated in § 5.4.3 'Symmetric Encryption'."]},{"tag":"p","children":["[Pre-NU7] let ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝖲"]},{"tag":"mi","children":["𝗒"]},{"tag":"mi","children":["𝗆"]}]}]}," be ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝖭"]},{"tag":"mi","children":["𝗈"]},{"tag":"mi","children":["𝗍"]},{"tag":"mi","children":["𝖾"]},{"tag":"mi","children":["𝖲"]},{"tag":"mi","children":["𝗒"]},{"tag":"mi","children":["𝗆"]}]}]},"."]},{"tag":"p","children":["[NU7 onward] if the note to be decrypted is in an output of a version 6 or later coinbase transaction, let ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝖲"]},{"tag":"mi","children":["𝗒"]},{"tag":"mi","children":["𝗆"]}]}]}," be ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝖭"]},{"tag":"mi","children":["𝗎"]},{"tag":"mi","children":["𝗅"]},{"tag":"mi","children":["𝗅"]},{"tag":"mi","children":["𝖲"]},{"tag":"mi","children":["𝗒"]},{"tag":"mi","children":["𝗆"]}]}]},", otherwise let it be ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝖭"]},{"tag":"mi","children":["𝗈"]},{"tag":"mi","children":["𝗍"]},{"tag":"mi","children":["𝖾"]},{"tag":"mi","children":["𝖲"]},{"tag":"mi","children":["𝗒"]},{"tag":"mi","children":["𝗆"]}]}]},"."]}]},{"tag":"p","children":["These changes apply identically to Mainnet and Testnet."]},{"tag":"p","children":["TODO: specify the handling of the ","ephemeralKey"," field."]},{"tag":"h2","children":["Deployment"],"id":"deployment"},{"tag":"p","children":["This ZIP is proposed to be deployed with the next transaction version change, which is assumed to be v6. ",{"tag":"sup","children":[{"tag":"a","children":["7"],"href":"#zip-0230","id":"footnote-reference-8"}]}]},{"tag":"h2","children":["Reference implementation"],"id":"reference-implementation"},{"tag":"p","children":["TBD."]},{"tag":"h2","children":["Acknowledgements"]