d key components derivations, we know that ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝗉"]},{"tag":"msub","children":[{"tag":"mi","children":["𝗄"]},{"tag":"mi","children":["𝖽"]}]}]}]}," is derived as: ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝗉"]},{"tag":"msub","children":[{"tag":"mi","children":["𝗄"]},{"tag":"mi","children":["𝖽"]}]}]},{"tag":"mo","children":["="]},{"tag":"mi","children":["m"]},{"tag":"mi","children":["a"]},{"tag":"mi","children":["t"]},{"tag":"mi","children":["h"]},{"tag":"mi","children":["s"]},{"tag":"mi","children":["f"]},{"tag":"mrow","children":[{"tag":"mi","children":["K"]},{"tag":"mi","children":["A"]},{"tag":"mi","children":["O"]},{"tag":"mi","children":["r"]},{"tag":"mi","children":["c"]},{"tag":"mi","children":["h"]},{"tag":"mi","children":["a"]},{"tag":"mi","children":["r"]},{"tag":"mi","children":["d"]},{"tag":"mo","children":["."]},{"tag":"mi","children":["D"]},{"tag":"mi","children":["e"]},{"tag":"mi","children":["r"]},{"tag":"mi","children":["i"]},{"tag":"mi","children":["v"]},{"tag":"mi","children":["e"]},{"tag":"mi","children":["P"]},{"tag":"mi","children":["u"]},{"tag":"mi","children":["b"]},{"tag":"mi","children":["l"]},{"tag":"mi","children":["i"]},{"tag":"mi","children":["c"]}]},{"tag":"mo","children":["("],"attrs":{"stretchy":"false"}},{"tag":"mrow","children":[{"tag":"mi","children":["𝗂"]},{"tag":"mi","children":["𝗏"]},{"tag":"mi","children":["𝗄"]}]},{"tag":"mo","children":[","]},{"tag":"msub","children":[{"tag":"mi","children":["𝗀"]},{"tag":"mi","children":["𝖽"]}]},{"tag":"mo","children":[")"],"attrs":{"stretchy":"false"}},{"tag":"mo","children":["="]},{"tag":"mo","children":["["],"attrs":{"stretchy":"false"}},{"tag":"mrow","children":[{"tag":"mi","children":["𝗂"]},{"tag":"mi","children":["𝗏"]},{"tag":"mi","children":["𝗄"]}]},{"tag":"mo","children":["]"],"attrs":{"stretchy":"false"}},{"tag":"msub","children":[{"tag":"mi","children":["𝗀"]},{"tag":"mi","children":["𝖽"]}]}]}," ",{"tag":"a","children":["[","12","]"],"id":"footnote-reference-12","href":"#protocol-orchard-keys"},"."]},{"tag":"p","children":["Given that ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝗂"]},{"tag":"mi","children":["𝗏"]},{"tag":"mi","children":["𝗄"]}]}]}," is derived from the spending key of the recipient of the funds, we can prove that the recipient of the funds in an Orchard Action is approving the receipt of the funds, by using a proof of knowledge of ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝗂"]},{"tag":"mi","children":["𝗏"]},{"tag":"mi","children":["𝗄"]}]}]},". Such proof of knowledge of ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝗂"]},{"tag":"mi","children":["𝗏"]},{"tag":"mi","children":["𝗄"]}]}]}," can be obtained by using the Non-Interactive Schnorr Protocol."]},{"tag":"p","children":["In fact, such proof of knowledge of ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝗂"]},{"tag":"mi","children":["𝗏"]},{"tag":"mi","children":["𝗄"]}]}]}," can be obtained by using a Schnorr Signature on the Action (the message) with ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝗂"]},{"tag":"mi","children":["𝗏"]},{"tag":"mi","children":["𝗄"]}]}]}," as signing/secret key and ",{"tag":"math","children":[{"tag":"msub","children":[{"tag":"mi","children":["𝗀"]},{"tag":"mi","children":["𝖽"]}]}]}," as group generator."]},{"tag":"p","children":[{"tag":"strong","children":["Note:"]}," Zcash Orchard already uses a Schnorr-based signature scheme instantiated with the Pallas curve, ",{"tag":"math","children":[{"tag":"mrow","children":[{"tag":"mi","children":["𝖱"]},{"tag":"mi","children":["𝖾"]},{"tag":"mi","children":["𝖽"]},{"tag":"mi","children":["𝖯"]},{"tag":"mi","children":["𝖺"]},{"tag":"mi","children":["𝗅"]},{"tag":"mi","children":["𝗅"]},{"tag":"mi","children":["𝖺"]},{"tag":"mi","children":["𝗌"]}]}]